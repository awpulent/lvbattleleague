# Production Postgres connection string (DigitalOcean App Platform)
DATABASE_URL=postgres://lvbl:lvbl@localhost:5432/lvbattleleague
STARTGG_API_TOKEN=your_start_gg_token_here
# Admin secret — use a 32+ char random value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SECRET=your_admin_secret_here
# Overlay API key — use a 24+ char random value
OVERLAY_API_KEY=your_overlay_api_key_here
NODE_ENV=development
PORT=3000

# Local docker-compose DB credentials (compose fails fast if POSTGRES_PASSWORD is unset)
POSTGRES_DB=lvbattleleague
POSTGRES_USER=lvbl
POSTGRES_PASSWORD=change_me_local_dev
