<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="theme-color" content="#0A0A0F">
    <title><%= season ? season.name : 'Season' %> Raffle — LV Battle League</title>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow:wght@400;600;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        html, body { overflow: hidden; }
        body { -webkit-tap-highlight-color: transparent; user-select: none; }
        .raffle {
            position: relative; z-index: 2;
            min-height: 100vh; min-height: 100dvh;
            display: flex; flex-direction: column;
            padding: env(safe-area-inset-top) 16px calc(16px + env(safe-area-inset-bottom));
            max-width: 720px; margin: 0 auto;
        }
        .raffle__top {
            display: flex; align-items: baseline; justify-content: space-between;
            gap: 10px; padding: 14px 2px 6px;
        }
        .raffle__title {
            font-family: 'Bebas Neue', sans-serif; letter-spacing: 1px;
            font-size: clamp(22px, 6vw, 34px); line-height: 1;
            color: var(--primary);
        }
        .raffle__sub { font-size: 13px; color: var(--text); opacity: .7; }
        .raffle__sub b { color: var(--accent); opacity: 1; }
        .iconbtn {
            background: var(--surface); border: 1px solid var(--border); color: var(--text);
            width: 40px; height: 40px; border-radius: 10px; font-size: 18px; cursor: pointer;
            display: inline-flex; align-items: center; justify-content: center;
        }
        .iconbtn:active { transform: scale(.92); }
        .raffle__tools { display: flex; gap: 8px; }

        .prize {
            margin: 10px 0 6px;
            display: flex; align-items: center; gap: 10px;
        }
        .prize__num {
            font-family: 'Bebas Neue', sans-serif; font-size: 20px; letter-spacing: 1px;
            color: var(--secondary); white-space: nowrap;
        }
        .prize__input {
            flex: 1; padding: 12px 14px; font-size: 16px;
            background: var(--dark); border: 1px solid var(--border); border-radius: 10px;
            color: var(--text); font-family: 'Barlow', sans-serif;
        }
        .prize__input:focus { outline: none; border-color: var(--primary); }

        .stage {
            flex: 1; min-height: 220px;
            display: flex; flex-direction: column; align-items: center; justify-content: center;
            position: relative; margin: 6px 0;
            border: 2px solid var(--border); border-radius: 18px;
            background:
                radial-gradient(circle at 50% 30%, rgba(255,215,0,.10), transparent 60%),
                var(--surface);
            overflow: hidden;
        }
        .stage.win { border-color: var(--primary); box-shadow: 0 0 40px rgba(255,215,0,.35); }
        .stage__label {
            position: absolute; top: 14px; left: 0; right: 0; text-align: center;
            font-size: 12px; letter-spacing: 3px; text-transform: uppercase;
            color: var(--text); opacity: .5;
        }
        .reel {
            font-family: 'Bebas Neue', sans-serif;
            font-size: clamp(36px, 13vw, 88px); line-height: 1.02;
            letter-spacing: 1px; text-align: center; padding: 0 14px;
            color: var(--text); word-break: break-word;
            text-shadow: 0 2px 24px rgba(0,0,0,.6);
        }
        .stage.spin .reel { color: #fff; filter: blur(.4px); opacity: .92; }
        .stage.win .reel {
            color: var(--primary);
            text-shadow: 0 0 30px rgba(255,215,0,.6), 0 0 60px rgba(255,23,68,.35);
            animation: pop .45s cubic-bezier(.2,1.4,.4,1) both;
        }
        @keyframes pop { 0% { transform: scale(.6); opacity: 0; } 100% { transform: scale(1); opacity: 1; } }
        .reel__meta {
            margin-top: 12px; font-family: 'Barlow', sans-serif; font-size: 15px;
            color: var(--accent); letter-spacing: .5px; min-height: 20px;
        }
        .stage.spin .reel__meta, .stage.idle .reel__meta { visibility: hidden; }

        .draw {
            margin-top: 10px; width: 100%; padding: 22px;
            font-family: 'Bebas Neue', sans-serif; font-size: 30px; letter-spacing: 3px;
            color: #0A0A0F; border: none; border-radius: 16px; cursor: pointer;
            background: linear-gradient(135deg, var(--primary), #ffb300);
            box-shadow: 0 8px 24px rgba(255,215,0,.3);
        }
        .draw:active { transform: translateY(2px); box-shadow: 0 4px 14px rgba(255,215,0,.3); }
        .draw:disabled { opacity: .4; box-shadow: none; cursor: default; }
        .draw.spinning {
            background: linear-gradient(135deg, var(--secondary), #b71540); color: #fff;
            pointer-events: none;
        }

        .winners { margin-top: 14px; }
        .winners__head {
            display: flex; align-items: center; justify-content: space-between;
            font-size: 12px; letter-spacing: 2px; text-transform: uppercase;
            color: var(--text); opacity: .6; margin-bottom: 8px; padding: 0 2px;
        }
        .winners__actions { display: flex; gap: 8px; }
        .minibtn {
            background: none; border: 1px solid var(--border); color: var(--text);
            font-size: 11px; letter-spacing: 1px; text-transform: uppercase;
            padding: 5px 10px; border-radius: 8px; cursor: pointer; opacity: .85;
        }
        .minibtn:active { transform: scale(.95); }
        #winnerList { list-style: none; display: flex; flex-direction: column; gap: 6px; max-height: 26vh; overflow-y: auto; }
        #winnerList li {
            display: flex; align-items: center; gap: 10px;
            padding: 9px 12px; background: var(--dark); border: 1px solid var(--border); border-radius: 10px;
            animation: slideIn .3s ease both;
        }
        @keyframes slideIn { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: none; } }
        #winnerList .w-prize { color: var(--secondary); font-weight: 800; font-size: 13px; flex: 1; }
        #winnerList .w-name { color: var(--primary); font-weight: 800; font-size: 15px; }
        #winnerList .w-pts { color: var(--text); opacity: .5; font-size: 12px; white-space: nowrap; }
        .empty { text-align: center; opacity: .4; font-size: 13px; padding: 18px; }

        #confetti { position: fixed; inset: 0; pointer-events: none; z-index: 50; }
        .toast {
            position: fixed; left: 50%; bottom: 24px; transform: translateX(-50%) translateY(40px);
            background: var(--surface); border: 1px solid var(--primary); color: var(--text);
            padding: 10px 18px; border-radius: 30px; font-size: 14px; z-index: 60;
            opacity: 0; transition: all .25s; white-space: nowrap;
        }
        .toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
    </style>
</head>
<body>
    <div class="grain"></div>
    <canvas id="confetti"></canvas>
    <div class="toast" id="toast"></div>

    <div class="raffle">
        <div class="raffle__top">
            <div>
                <div class="raffle__title"><%= season ? season.name : 'Season' %> Raffle</div>
                <div class="raffle__sub">
                    <b id="poolCount">0</b> players · <b id="entryCount">0</b> entries left
                </div>
            </div>
            <div class="raffle__tools">
                <button class="iconbtn" id="muteBtn" title="Sound">🔊</button>
                <button class="iconbtn" id="fsBtn" title="Fullscreen">⛶</button>
            </div>
        </div>

        <div class="prize">
            <span class="prize__num" id="prizeNum">Prize #1</span>
            <input class="prize__input" id="prizeName" type="text" placeholder="Prize name (optional)" autocomplete="off">
        </div>

        <div class="stage idle" id="stage">
            <div class="stage__label" id="stageLabel">Ready</div>
            <div class="reel" id="reel">Tap DRAW</div>
            <div class="reel__meta" id="reelMeta"></div>
        </div>

        <button class="draw" id="drawBtn">DRAW WINNER</button>

        <div class="winners">
            <div class="winners__head">
                <span>Winners</span>
                <div class="winners__actions">
                    <button class="minibtn" id="undoBtn">Undo</button>
                    <button class="minibtn" id="copyBtn">Copy</button>
                    <button class="minibtn" id="resetBtn">Reset</button>
                </div>
            </div>
            <ul id="winnerList"><li class="empty" id="emptyRow">No winners yet — draw the first prize!</li></ul>
        </div>
    </div>

    <script>
        const SEASON_NAME = <%- JSON.stringify(season ? season.name : 'Season').replace(/</g, '\\u003c') %>;
        const INITIAL_ENTRIES = <%- JSON.stringify(entries).replace(/</g, '\\u003c') %>;

        // ---- state ----
        let pool = INITIAL_ENTRIES.map(e => ({ name: e.name, points: e.points }));
        const totalStartEntries = pool.reduce((s, p) => s + p.points, 0);
        const winners = [];
        let drawing = false;
        let prizeNo = 1;
        let muted = false;

        const $ = id => document.getElementById(id);
        const stage = $('stage'), reel = $('reel'), reelMeta = $('reelMeta'),
              stageLabel = $('stageLabel'), drawBtn = $('drawBtn'),
              winnerList = $('winnerList');

        function fmt(n) { return n.toLocaleString('en-US'); }

        function updateStats() {
            const entriesLeft = pool.reduce((s, p) => s + p.points, 0);
            $('poolCount').textContent = fmt(pool.length);
            $('entryCount').textContent = fmt(entriesLeft);
            $('prizeNum').textContent = 'Prize #' + prizeNo;
            if (!drawing) {
                if (!pool.length) {
                    drawBtn.disabled = true;
                    drawBtn.textContent = 'ALL PRIZES DRAWN';
                    reel.textContent = '🏆';
                    stageLabel.textContent = 'Pool empty';
                } else {
                    drawBtn.disabled = false;
                    drawBtn.textContent = 'DRAW WINNER';
                }
            }
        }

        // ---- weighted random pick ----
        function weightedPick() {
            const total = pool.reduce((s, p) => s + p.points, 0);
            let r = Math.random() * total;
            for (const p of pool) { r -= p.points; if (r < 0) return p; }
            return pool[pool.length - 1];
        }

        // ---- sound (WebAudio, no assets) ----
        let actx = null;
        function audio() { if (!actx) { try { actx = new (window.AudioContext || window.webkitAudioContext)(); } catch (e) {} } return actx; }
        function blip(freq, dur, type, gain) {
            if (muted) return; const a = audio(); if (!a) return;
            const o = a.createOscillator(), g = a.createGain();
            o.type = type || 'square'; o.frequency.value = freq;
            g.gain.value = gain || 0.04;
            o.connect(g); g.connect(a.destination);
            const t = a.currentTime;
            g.gain.setValueAtTime(g.gain.value, t);
            g.gain.exponentialRampToValueAtTime(0.0001, t + (dur || 0.05));
            o.start(t); o.stop(t + (dur || 0.05));
        }
        function tick() { blip(420 + Math.random() * 80, 0.03, 'square', 0.03); }
        function fanfare() {
            if (muted) return;
            [523, 659, 784, 1047].forEach((f, i) => setTimeout(() => blip(f, 0.5, 'triangle', 0.06), i * 90));
        }

        // ---- draw ----
        function draw() {
            if (drawing || !pool.length) return;
            const winner = weightedPick();
            const oddsPct = (winner.points / pool.reduce((s, p) => s + p.points, 0) * 100);
            drawing = true;
            drawBtn.classList.add('spinning');
            drawBtn.textContent = 'DRAWING…';
            stage.className = 'stage spin';
            stageLabel.textContent = ($('prizeName').value.trim() || ('Prize #' + prizeNo)).toUpperCase();
            reelMeta.textContent = '';
            try { audio() && audio().resume && audio().resume(); } catch (e) {}

            const start = performance.now();
            const duration = 4200;
            let lastFlip = 0;
            function frame(now) {
                const t = Math.min(1, (now - start) / duration);
                if (t >= 1) {
                    reel.textContent = winner.name;
                    finish(winner, oddsPct);
                    return;
                }
                const ease = 1 - Math.pow(1 - t, 3);       // slows toward the end
                const interval = 45 + ease * 280;
                if (now - lastFlip >= interval) {
                    lastFlip = now;
                    reel.textContent = pool[Math.floor(Math.random() * pool.length)].name;
                    tick();
                }
                requestAnimationFrame(frame);
            }
            requestAnimationFrame(frame);
        }

        function finish(winner, oddsPct) {
            stage.className = 'stage win';
            reelMeta.textContent = fmt(winner.points) + ' entries · ' + oddsPct.toFixed(1) + '% odds';
            fanfare();
            burst();
            navigator.vibrate && navigator.vibrate([0, 60, 40, 120]);

            const prizeLabel = $('prizeName').value.trim() || ('Prize #' + prizeNo);
            winners.push({ prize: prizeLabel, name: winner.name, points: winner.points });
            renderWinners();

            // remove winner from the pool for remaining prizes
            pool = pool.filter(p => p !== winner);
            prizeNo++;
            $('prizeName').value = '';

            drawing = false;
            drawBtn.classList.remove('spinning');
            updateStats();
        }

        function renderWinners() {
            $('emptyRow') && $('emptyRow').remove();
            winnerList.innerHTML = '';
            winners.forEach((w, i) => {
                const li = document.createElement('li');
                const prize = document.createElement('span'); prize.className = 'w-prize'; prize.textContent = w.prize;
                const name = document.createElement('span'); name.className = 'w-name'; name.textContent = w.name;
                const pts = document.createElement('span'); pts.className = 'w-pts'; pts.textContent = fmt(w.points) + ' ent';
                li.append(prize, name, pts);
                winnerList.appendChild(li);
            });
            winnerList.scrollTop = winnerList.scrollHeight;
        }

        // ---- undo / copy / reset ----
        function undo() {
            if (drawing || !winners.length) return;
            const last = winners.pop();
            pool.push({ name: last.name, points: last.points });
            prizeNo = Math.max(1, prizeNo - 1);
            if (!winners.length) {
                winnerList.innerHTML = '<li class="empty" id="emptyRow">No winners yet — draw the first prize!</li>';
            } else { renderWinners(); }
            stage.className = 'stage idle'; reel.textContent = 'Tap DRAW'; stageLabel.textContent = 'Ready';
            updateStats();
            toast('Undid ' + last.name);
        }

        function copyResults() {
            if (!winners.length) return toast('No winners yet');
            const lines = [SEASON_NAME + ' — Raffle Winners', ''];
            winners.forEach(w => lines.push(w.prize + ': ' + w.name + ' (' + w.points + ' entries)'));
            const text = lines.join('\n');
            const done = () => toast('Results copied');
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(text).then(done).catch(() => fallbackCopy(text, done));
            } else { fallbackCopy(text, done); }
        }
        function fallbackCopy(text, done) {
            const ta = document.createElement('textarea'); ta.value = text;
            ta.style.position = 'fixed'; ta.style.opacity = '0'; document.body.appendChild(ta);
            ta.select(); try { document.execCommand('copy'); done(); } catch (e) {} ta.remove();
        }
        function reset() {
            if (drawing) return;
            if (!confirm('Reset the raffle? All ' + winners.length + ' drawn winner(s) will be cleared and everyone returns to the pool.')) return;
            pool = INITIAL_ENTRIES.map(e => ({ name: e.name, points: e.points }));
            winners.length = 0; prizeNo = 1;
            winnerList.innerHTML = '<li class="empty" id="emptyRow">No winners yet — draw the first prize!</li>';
            stage.className = 'stage idle'; reel.textContent = 'Tap DRAW'; stageLabel.textContent = 'Ready'; reelMeta.textContent = '';
            updateStats(); toast('Raffle reset');
        }

        // ---- toast ----
        let toastTimer;
        function toast(msg) {
            const el = $('toast'); el.textContent = msg; el.classList.add('show');
            clearTimeout(toastTimer); toastTimer = setTimeout(() => el.classList.remove('show'), 1800);
        }

        // ---- confetti ----
        const cv = $('confetti'), cx = cv.getContext('2d');
        let parts = [], rafC = null;
        function sizeCanvas() { cv.width = innerWidth; cv.height = innerHeight; }
        sizeCanvas(); addEventListener('resize', sizeCanvas);
        const COLORS = ['#FFD700', '#FF1744', '#00E5FF', '#ffffff', '#ffb300'];
        function burst() {
            for (let i = 0; i < 140; i++) {
                parts.push({
                    x: innerWidth / 2, y: innerHeight * 0.38,
                    vx: (Math.random() - 0.5) * 16, vy: Math.random() * -16 - 4,
                    g: 0.4 + Math.random() * 0.3, s: 4 + Math.random() * 6,
                    rot: Math.random() * 6.28, vr: (Math.random() - 0.5) * 0.4,
                    c: COLORS[Math.floor(Math.random() * COLORS.length)], life: 120
                });
            }
            if (!rafC) loopC();
        }
        function loopC() {
            cx.clearRect(0, 0, cv.width, cv.height);
            parts.forEach(p => {
                p.vy += p.g; p.x += p.vx; p.y += p.vy; p.rot += p.vr; p.life--;
                cx.save(); cx.translate(p.x, p.y); cx.rotate(p.rot); cx.fillStyle = p.c;
                cx.fillRect(-p.s / 2, -p.s / 2, p.s, p.s * 0.6); cx.restore();
            });
            parts = parts.filter(p => p.life > 0 && p.y < cv.height + 40);
            if (parts.length) { rafC = requestAnimationFrame(loopC); }
            else { cx.clearRect(0, 0, cv.width, cv.height); rafC = null; }
        }

        // ---- wiring ----
        drawBtn.addEventListener('click', draw);
        $('undoBtn').addEventListener('click', undo);
        $('copyBtn').addEventListener('click', copyResults);
        $('resetBtn').addEventListener('click', reset);
        $('muteBtn').addEventListener('click', () => {
            muted = !muted; $('muteBtn').textContent = muted ? '🔇' : '🔊'; if (!muted) blip(660, 0.06, 'triangle', 0.05);
        });
        $('fsBtn').addEventListener('click', () => {
            if (document.fullscreenElement) document.exitFullscreen();
            else document.documentElement.requestFullscreen && document.documentElement.requestFullscreen();
        });
        // keep an accidental form-submit / enter on the prize field from drawing
        $('prizeName').addEventListener('keydown', e => { if (e.key === 'Enter') e.target.blur(); });

        if (!pool.length) {
            reel.textContent = 'No entries';
            stageLabel.textContent = 'Nothing to raffle';
            drawBtn.disabled = true;
        }
        updateStats();
    </script>
</body>
</html>
