<% if (typeof sponsors !== 'undefined' && sponsors.length > 0) { %>
<div class="sponsors-bar">
    <% sponsors.forEach(s => { %>
        <% if (s.website_url) { %>
            <a href="<%= s.website_url %>" target="_blank" rel="noopener">
                <img src="<%= s.logo_url %>" alt="<%= s.name %>" class="sponsor-logo">
            </a>
        <% } else { %>
            <img src="<%= s.logo_url %>" alt="<%= s.name %>" class="sponsor-logo">
        <% } %>
    <% }) %>
</div>
<% } %>
