<%- include('partials/head') %>
<%- include('partials/header') %>

<% if (seasons.length > 0) { %>
<div class="season-selector">
    <% seasons.forEach(season => { %>
        <a href="/?season=<%= season.id %>"
           class="season-btn <%= currentSeason && currentSeason.id === season.id ? 'active' : '' %>">
            <%= season.name %>
        </a>
    <% }) %>
</div>
<% } %>

<%- include('partials/season-sponsor', { sponsor, currentSeason }) %>

<%- include('partials/stats-grid', { stats }) %>

<% if (typeof error !== 'undefined' && error) { %>
    <div class="error"><%= error %></div>
<% } else { %>
    <%- include('partials/standings-table', { standings }) %>
    <%- include('partials/week-cards', { weeks }) %>
<% } %>
<%- include('partials/foot') %>
