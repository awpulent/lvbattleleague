<%- include('partials/head') %>
<%- include('partials/header') %>

<h2 class="section-title">Sync Tournament</h2>
<div class="rankings-table" style="margin-bottom: 40px;">
    <div style="padding: 20px 30px;">
        <form action="/admin/sync" method="POST" style="display: flex; flex-direction: column; gap: 15px; max-width: 500px;">
            <div>
                <label style="color: var(--primary); font-weight: 600; display: block; margin-bottom: 5px;">Tournament Slug</label>
                <input type="text" name="tournamentSlug" placeholder="lv-battle-league-week-12" required
                    style="width: 100%; padding: 10px; background: var(--dark); border: 1px solid var(--border); color: var(--text); font-family: 'Barlow', sans-serif;">
            </div>
            <div>
                <label style="color: var(--primary); font-weight: 600; display: block; margin-bottom: 5px;">Season</label>
                <select name="seasonId" required style="width: 100%; padding: 10px; background: var(--dark); border: 1px solid var(--border); color: var(--text); font-family: 'Barlow', sans-serif;">
                    <% seasons.forEach(s => { %>
                        <option value="<%= s.id %>"><%= s.name %></option>
                    <% }) %>
                </select>
            </div>
            <div>
                <label style="color: var(--primary); font-weight: 600; display: block; margin-bottom: 5px;">Week Number</label>
                <input type="number" name="weekNumber" min="1" required
                    style="width: 100%; padding: 10px; background: var(--dark); border: 1px solid var(--border); color: var(--text); font-family: 'Barlow', sans-serif;">
            </div>
            <button type="submit" class="season-btn active" style="cursor: pointer; border: none;">Sync Now</button>
        </form>
    </div>
</div>

<h2 class="section-title">Sponsors</h2>
<div class="rankings-table" style="margin-bottom: 40px;">
    <div style="padding: 20px 30px;">
        <form action="/admin/sponsors" method="POST" enctype="multipart/form-data"
            style="display: flex; flex-direction: column; gap: 15px; max-width: 500px; margin-bottom: 30px;">
            <div>
                <label style="color: var(--primary); font-weight: 600; display: block; margin-bottom: 5px;">Sponsor Name</label>
                <input type="text" name="name" required
                    style="width: 100%; padding: 10px; background: var(--dark); border: 1px solid var(--border); color: var(--text); font-family: 'Barlow', sans-serif;">
            </div>
            <div>
                <label style="color: var(--primary); font-weight: 600; display: block; margin-bottom: 5px;">Logo File</label>
                <input type="file" name="logo" accept="image/*" required
                    style="color: var(--text); font-family: 'Barlow', sans-serif;">
            </div>
            <div>
                <label style="color: var(--primary); font-weight: 600; display: block; margin-bottom: 5px;">Website URL (optional)</label>
                <input type="text" name="website_url" placeholder="https://..."
                    style="width: 100%; padding: 10px; background: var(--dark); border: 1px solid var(--border); color: var(--text); font-family: 'Barlow', sans-serif;">
            </div>
            <button type="submit" class="season-btn active" style="cursor: pointer; border: none;">Add Sponsor</button>
        </form>

        <p style="color: var(--text); opacity: 0.7; margin-bottom: 20px; max-width: 700px;">
            Adding a sponsor only registers it. Each season shows one presenting
            sponsor — assign it in the Seasons list below.
        </p>

        <% if (sponsors.length > 0) { %>
        <h3 style="color: var(--primary); margin-bottom: 15px;">Current Sponsors</h3>
        <% sponsors.forEach(s => { %>
            <div style="display: flex; align-items: center; gap: 15px; margin-bottom: 10px; padding: 10px; border: 1px solid var(--border);">
                <span style="color: var(--primary); font-weight: 600; min-width: 40px;">#<%= s.id %></span>
                <% if (s.has_logo) { %>
                    <img src="<%= s.logo_url %>" alt="<%= s.name %>" style="height: 30px;">
                <% } %>
                <span style="flex: 1;">
                    <%= s.name %>
                    <span style="opacity: 0.7; font-size: 0.9rem;">
                        — <%= s.season_names.length ? `presenting ${s.season_names.join(', ')}` : 'unassigned' %>
                    </span>
                    <% if (!s.has_logo) { %>
                        <span style="color: var(--secondary); font-size: 0.85rem; margin-left: 6px;">logo missing — upload one with Replace logo</span>
                    <% } %>
                </span>
                <form action="/admin/sponsors/<%= s.id %>/logo" method="POST" enctype="multipart/form-data"
                    style="margin: 0; display: flex; align-items: center; gap: 8px;">
                    <input type="file" name="logo" accept="image/*" required
                        style="color: var(--text); font-family: 'Barlow', sans-serif; max-width: 220px;">
                    <button type="submit" class="season-btn" style="cursor: pointer; padding: 5px 10px;">Replace logo</button>
                </form>
                <form action="/admin/sponsors/<%= s.id %>/delete" method="POST" style="margin: 0;">
                    <button type="submit" style="background: var(--secondary); border: none; color: white; padding: 5px 10px; cursor: pointer; font-family: 'Barlow', sans-serif;">Delete</button>
                </form>
            </div>
        <% }) %>
        <% } %>

        <h3 style="color: var(--primary); margin: 25px 0 15px;">Seasons</h3>
        <p style="color: var(--text); opacity: 0.7; margin-bottom: 15px; max-width: 700px;">
            Each season's presenting sponsor and drop-worst-week setting are saved
            per row. "No sponsor" clears the sponsor block from that season's page.
            "Make active" switches the site's default season; only one season is
            active at a time.
        </p>
        <% seasons.forEach(s => { %>
            <div style="display: flex; align-items: center; flex-wrap: wrap; gap: 15px; margin-bottom: 10px; padding: 10px; border: 1px solid var(--border);">
                <span style="color: var(--primary); font-weight: 600; min-width: 40px;">#<%= s.id %></span>
                <span style="flex: 1; min-width: 140px;">
                    <%= s.name %>
                    <% if (s.is_active) { %><span style="color: var(--accent); font-weight: 600; font-size: 0.85rem; margin-left: 6px;">ACTIVE</span><% } %>
                </span>
                <form action="/admin/update-season" method="POST"
                    style="display: flex; align-items: center; flex-wrap: wrap; gap: 10px; margin: 0;">
                    <input type="hidden" name="seasonId" value="<%= s.id %>">
                    <label style="color: var(--primary); font-weight: 600;">Sponsor</label>
                    <select name="sponsorId" style="padding: 8px; background: var(--dark); border: 1px solid var(--border); color: var(--text); font-family: 'Barlow', sans-serif;">
                        <option value="" <%= s.sponsor_id ? '' : 'selected' %>>No sponsor</option>
                        <% sponsors.forEach(sp => { %>
                            <option value="<%= sp.id %>" <%= s.sponsor_id === sp.id ? 'selected' : '' %>>#<%= sp.id %> <%= sp.name %></option>
                        <% }) %>
                    </select>
                    <label style="color: var(--primary); font-weight: 600;">Drop worst week</label>
                    <select name="dropWorstWeek" style="padding: 8px; background: var(--dark); border: 1px solid var(--border); color: var(--text); font-family: 'Barlow', sans-serif;">
                        <option value="true" <%= s.drop_worst_week ? 'selected' : '' %>>On</option>
                        <option value="false" <%= s.drop_worst_week ? '' : 'selected' %>>Off</option>
                    </select>
                    <button type="submit" class="season-btn active" style="cursor: pointer; border: none; padding: 8px 16px;">Save</button>
                </form>
                <% if (!s.is_active) { %>
                <form action="/admin/update-season" method="POST" style="margin: 0;">
                    <input type="hidden" name="seasonId" value="<%= s.id %>">
                    <input type="hidden" name="isActive" value="true">
                    <button type="submit" class="season-btn" style="cursor: pointer; padding: 8px 16px;">Make active</button>
                </form>
                <% } %>
            </div>
        <% }) %>
    </div>
</div>
<%- include('partials/foot') %>
